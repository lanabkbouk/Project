echo "VITE_API_BASE_URL=http://127.0.0.1:8000/api" > .env.example
echo "" >> .env.example
echo "# وضع تشغيل الخدمات: mock (بيانات تجريبية محليًا) أو real (ربط فعلي بـ Laravel)" >> .env.example
echo "# مفتاح واحد فقط لكل المشروع بدل متغير منفصل لكل خدمة" >> .env.example
echo "VITE_API_MODE=mock" >> .env.example